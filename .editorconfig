root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# _data/programacao.json é CRLF e sem newline final; não reformatar.
[_data/*.json]
insert_final_newline = unset
end_of_line = unset
